{
  "$id": "https://schemas.ory.sh/kratos/selfservice/strategy/profile/verification.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "enum": [
        "code",
        "link"
      ]
    },
    "code": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "maxLength": 320
    },
    "sms": {
      "type": "string",
      "format": "tel"
    },
    "flow": {
      "type": "string",
      "format": "uuid"
    },
    "csrf_token": {
      "type": "string"
    },
    "transient_payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "not": {
    "required": ["sms", "email"]
  }
}
